# Copiá este archivo como .env y completá los datos. Nunca subas el .env a GitHub.

# Datos de WhatsApp Cloud (developers.facebook.com > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que inventás vos; la misma se pone al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# Clave para ver la lista de turnos en /turnos?clave=...
CLAVE_ADMIN=

# Opcional
BASE_DE_DATOS=turnos.db
PORT=5000
